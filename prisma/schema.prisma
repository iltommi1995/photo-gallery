// Photo Gallery data model — Album -> Chapter -> Placement -> Photo.
// See AGENTS.md "Data model" and stories/docs/data-model.mdx for the
// narrative version, and docs/ai/add-album-layout-variant.md before
// touching PlacementSize or the Chapter/Placement shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Site-wide content not owned by any single album: the home hero and the
// About Me page. Not in the original spec's §6 listing, but both spec §5.1
// ("immagine di apertura configurabile da admin") and §5.4 ("editabile da
// admin") require somewhere to persist it — a single-row settings table is
// the smallest addition that does that.
model SiteSettings {
  id           String   @id @default("singleton")
  siteTitle    String   @default("Photography")
  heroPhotoId  String?
  aboutTitle   String?
  aboutBody    String?
  aboutPhotoId String?
  updatedAt    DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum AlbumStatus {
  DRAFT
  PUBLISHED
}

model Album {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  subtitle     String?
  description  String?
  coverPhotoId String?
  locationName String?
  countryCode  String?
  status       AlbumStatus @default(DRAFT)
  order        Int         @default(0)
  chapters     Chapter[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, order])
}

model Chapter {
  id         String      @id @default(cuid())
  albumId    String
  album      Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  label      String // e.g. "2018", "Trip to the Alps"
  order      Int
  placements Placement[]

  @@index([albumId, order])
}

enum PlacementSize {
  SMALL
  MEDIUM
  LARGE
  FULL
}

model Placement {
  id        String        @id @default(cuid())
  chapterId String
  chapter   Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  photoId   String
  photo     Photo         @relation(fields: [photoId], references: [id])
  order     Int
  size      PlacementSize @default(MEDIUM)
  colSpan   Int?
  rowSpan   Int?

  @@index([chapterId, order])
  @@index([photoId])
}

model Photo {
  id           String  @id @default(cuid())
  filename     String
  originalPath String
  width        Int
  height       Int
  blurDataUrl  String?
  caption      String?
  altText      String?

  // Variant paths (generated by src/lib/image — thumbnail/medium/full,
  // AVIF/WebP where supported). Nullable until processing completes.
  thumbnailPath String?
  mediumPath    String?
  fullPath      String?

  // EXIF / technical metadata
  cameraMake    String?
  cameraModel   String?
  lens          String?
  focalLengthMm Float?
  aperture      Float? // f-stop, e.g. 2.8
  shutterSpeed  String? // e.g. "1/250"
  iso           Int?
  takenAt       DateTime?

  // Location
  locationName String?
  gpsLat       Float?
  gpsLng       Float?

  // Film / analog (no EXIF — filled in manually by the admin)
  isAnalog Boolean @default(false)
  filmStock String?

  tags       Tag[]
  placements Placement[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([takenAt])
}

model Tag {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  photos Photo[]
}
