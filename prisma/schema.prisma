// Photo Gallery data model — Album -> Chapter -> Placement -> Photo.
// See AGENTS.md "Data model" and stories/docs/data-model.mdx for the
// narrative version, and docs/ai/add-album-layout-variant.md before
// touching PlacementSize or the Chapter/Placement shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Site-wide content not owned by any single album: the home hero and the
// About Me page. Not in the original spec's §6 listing, but both spec §5.1
// ("immagine di apertura configurabile da admin") and §5.4 ("editabile da
// admin") require somewhere to persist it — a single-row settings table is
// the smallest addition that does that.
model SiteSettings {
  id           String   @id @default("singleton")
  siteTitle    String   @default("Photography")
  heroPhotoId  String?
  aboutTitle   String?
  aboutBody    String?
  aboutPhotoId String?
  updatedAt    DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum AlbumStatus {
  DRAFT
  PUBLISHED
}

// How consecutive chapters flow into one another on the public album page.
// PAGED (default) is the current behavior: each chapter is its own section
// with breathing-room padding around it. CONTINUOUS removes that padding so
// chapters run into each other with no visible gap, reading as one page.
enum ChapterLayout {
  PAGED
  CONTINUOUS
}

model Album {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  subtitle          String?
  description       String?
  coverPhotoId      String?
  locationName      String?
  countryCode       String?
  status            AlbumStatus   @default(DRAFT)
  order             Int           @default(0)
  showChapterLabels Boolean       @default(true)
  chapterLayout     ChapterLayout @default(PAGED)
  chapters          Chapter[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, order])
}

model Chapter {
  id         String      @id @default(cuid())
  albumId    String
  album      Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  // Which surface this chapter's structure (count/labels/order/placements)
  // belongs to. WEB (default) is the desktop/canonical mosaic; a chapter
  // belongs to exactly one viewport, giving each context an independently
  // authored chapter list (not just independently authored photos within
  // shared chapter boundaries).
  viewport   Viewport    @default(WEB)
  label      String // e.g. "2018", "Trip to the Alps"
  order      Int
  placements Placement[]

  @@index([albumId, viewport, order])
}

enum PlacementType {
  PHOTO
  TEXT
}

// Which surface a Chapter (and by extension its Placements) is authored
// for. WEB (default) is the desktop/canonical mosaic; MOBILE_LANDSCAPE/
// MOBILE_PORTRAIT are optional, fully independent alternate chapter lists
// (own chapter count/labels/order/photo selection, not a resized copy of
// WEB) rendered when the viewer is not on a real desktop. "Does this album
// have a mobile override" is a derived fact (any chapters with that
// viewport exist for it).
enum Viewport {
  WEB
  MOBILE_LANDSCAPE
  MOBILE_PORTRAIT
}

model Placement {
  id        String        @id @default(cuid())
  chapterId String
  chapter   Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  type      PlacementType @default(PHOTO)
  // PHOTO blocks:
  photoId             String?
  photo               Photo?  @relation(fields: [photoId], references: [id])
  // When true, rowSpan is derived from the photo's real aspect ratio
  // (src/lib/gallery/aspect-ratio.ts) instead of being chosen freely, and
  // the image is letterboxed (object-contain) instead of cropped.
  preserveAspectRatio Boolean @default(false)
  // TEXT blocks: sanitized rich-text HTML (bold/italic/links only — see
  // src/lib/sanitize-html.ts), rendered as-is by ChapterMosaic.
  textContent String?
  order      Int
  // How many grid cells this placement spans, set freely by the admin
  // editor (1-4 columns on the 4-column grid, see src/lib/gallery/grid.ts)
  // rather than picked from a fixed S/M/L/F preset.
  colSpan    Int      @default(1)
  rowSpan    Int      @default(1)
  gridColumn Int?
  gridRow    Int?

  @@index([chapterId, order])
  @@index([photoId])
}

model Photo {
  id           String  @id @default(cuid())
  filename     String
  originalPath String
  width        Int
  height       Int
  blurDataUrl  String?
  caption      String?
  altText      String?

  // Variant paths (generated by src/lib/image — thumbnail/medium/full,
  // AVIF/WebP where supported). Nullable until processing completes.
  thumbnailPath String?
  mediumPath    String?
  fullPath      String?

  // EXIF / technical metadata
  cameraMake    String?
  cameraModel   String?
  lens          String?
  focalLengthMm Float?
  aperture      Float? // f-stop, e.g. 2.8
  shutterSpeed  String? // e.g. "1/250"
  iso           Int?
  takenAt       DateTime?

  // Location
  locationName String?
  gpsLat       Float?
  gpsLng       Float?

  // Film / analog (no EXIF — filled in manually by the admin)
  isAnalog  Boolean @default(false)
  filmStock String?

  tags       Tag[]
  placements Placement[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([takenAt])
}

model Tag {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  photos Photo[]
}
