# --- Local development -------------------------------------------------
# Copy to .env and run `docker compose -f docker-compose.dev.yml up -d`
# for a local Postgres matching the DATABASE_URL default below.
#
# --- Production (docker-compose.yml) ------------------------------------
# Copy to .env in the same directory as docker-compose.yml and replace the
# values marked below. Docker Compose loads .env automatically. See
# docs/deployment.md for the full walkthrough.

# Dev default: postgresql://photogallery:photogallery@localhost:5433/photogallery
# Production: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL="postgresql://photogallery:photogallery@localhost:5433/photogallery"

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Seeded on first `pnpm db:seed` if no Admin row exists yet.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Admin"

# Public site origin — used for absolute URLs (OG images, sitemap,
# canonical links) and baked into the client bundle at build time.
# Dev default is fine as-is; production: your real https:// domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local photo storage volume (originals + generated variants).
# Dev default is fine as-is; production: leave as /app/storage (matches
# the volume mount in docker-compose.yml — don't change this one).
STORAGE_DIR="./storage"

# --- Production only (docker-compose.yml) -------------------------------

# Postgres credentials for the `db` service. Must match the DATABASE_URL
# above (production form).
POSTGRES_USER="photogallery"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="photogallery"
